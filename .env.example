# ========================================================
# CLOUDFLARE R2 CONFIGURATION
# ========================================================
# Cloudflare Dashboard -> R2 Overview -> Account ID
R2_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare Dashboard -> R2 Overview -> "Manage R2 API Tokens"
# Ensure permissions include "Object Read & Write"
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Target Bucket Name in Cloudflare R2
R2_BUCKET_NAME=your-bucket-name

# Root Folder Scope (Defaults to "uploader")
# All operations (read, list, upload, delete) are strictly sandboxed inside this folder
R2_ROOT_FOLDER=uploader

# Optional: Public Domain / Custom CDN Domain attached to the bucket
# Example: https://pub-xxxxxxxx.r2.dev or https://cdn.yourdomain.com
# If left blank, download and stream links proxy directly through the Go server
R2_PUBLIC_DOMAIN=https://cdn.yourdomain.com/

# ========================================================
# SERVER CONFIGURATION
# ========================================================
PORT=8080

# Public application domain for Web Dashboard & API links
# Used to generate absolute URLs for files, APIs, and Web UI
APP_URL=https://r2-upl.vhming.com

# Master Admin Key (grants full access to the Web Dashboard and Session Key management)
# Leave blank to run in open mode without authentication
ADMIN_KEY=your_master_admin_secret_key_here

# SQLite Database Path (Stores Session Keys and Upload Audit Logs)
SQLITE_PATH=data/data.db

# Prefix for automatically generated session keys (defaults to "sk_vhming_")
KEY_PREFIX=sk_vhming_
